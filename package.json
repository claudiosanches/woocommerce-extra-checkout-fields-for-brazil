{
  "name": "woocommerce-extra-checkout-fields-for-brazil",
  "description": "Brazilian Market on WooCommerce",
  "version": "5.0.0",
  "license": "GPL-3.0-or-later",
  "scripts": {
    "build": "wp-scripts build --webpack-src-dir=assets/js",
    "start": "wp-scripts start --webpack-src-dir=assets/js",
    "format": "wp-scripts format",
    "lint:js": "wp-scripts lint-js",
    "lint:css": "wp-scripts lint-style",
    "lint:php": "composer run-script phpcs",
    "lint:types": "tsc --noEmit",
    "lint": "npm run lint:js && npm run lint:css && npm run lint:types && npm run lint:php",
    "fix:js": "wp-scripts lint-js --fix",
    "fix:css": "wp-scripts lint-style --fix",
    "fix:php": "composer run-script phpcbf",
    "test:unit": "wp-scripts test-unit-js",
    "build:pot": "npm run build && composer run-script makepot",
    "build:json": "composer run-script makejson",
    "build:md": "wp-readme-to-md --screenshot-url=https://ps.w.org/woocommerce-extra-checkout-fields-for-brazil/assets/{screenshot}.png",
    "plugin-zip": "wp-scripts plugin-zip",
    "env": "wp-env",
    "packages-update": "wp-scripts packages-update",
    "test:php": "composer run-script test:unit",
    "test:php-integration": "wp-env run cli --config .wp-env.tests.json --env-cwd=wp-content/plugins/woocommerce-extra-checkout-fields-for-brazil vendor/bin/phpunit -- --testsuite=integration",
    "test": "npm run test:unit && npm run test:php",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "env:tests": "wp-env start --config .wp-env.tests.json"
  },
  "dependencies": {
    "@wordpress/i18n": "^6.29.0",
    "mailcheck": "^1.1.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/wordpress__block-editor": "^15.0.6",
    "@woocommerce/dependency-extraction-webpack-plugin": "^5.1.0",
    "@wordpress/block-editor": "^18.0.0",
    "@wordpress/blocks": "^16.1.0",
    "@wordpress/data": "^10.56.0",
    "@wordpress/element": "^8.8.0",
    "@wordpress/env": "^11.13.0",
    "@wordpress/plugins": "^7.56.0",
    "@wordpress/scripts": "^34.1.0",
    "@wordpress/server-side-render": "^6.32.0",
    "typescript": "^6.0.3",
    "wp-readme-to-markdown": "^1.0.1"
  }
}
