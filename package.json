{
  "name": "woocommerce-extra-checkout-fields-for-brazil",
  "description": "Brazilian Market on WooCommerce",
  "version": "5.0.0",
  "license": "GPL-3.0-or-later",
  "scripts": {
    "build": "wp-scripts build",
    "start": "wp-scripts start",
    "format": "wp-scripts format",
    "lint:js": "wp-scripts lint-js",
    "lint:css": "wp-scripts lint-style",
    "lint:php": "composer run-script phpcs",
    "lint": "npm run lint:js && npm run lint:css && npm run lint:php",
    "fix:js": "wp-scripts lint-js --fix",
    "fix:css": "wp-scripts lint-style --fix",
    "fix:php": "composer run-script phpcbf",
    "test:unit": "wp-scripts test-unit-js",
    "build:pot": "composer run-script makepot",
    "build:md": "wp-readme-to-md --screenshot-url=https://ps.w.org/woocommerce-extra-checkout-fields-for-brazil/assets/{screenshot}.png",
    "plugin-zip": "wp-scripts plugin-zip",
    "env": "wp-env",
    "packages-update": "wp-scripts packages-update",
    "test:php": "composer run-script test:unit",
    "test:php-integration": "wp-env run cli --config .wp-env.tests.json --env-cwd=wp-content/plugins/woocommerce-extra-checkout-fields-for-brazil vendor/bin/phpunit -- --testsuite=integration",
    "test": "npm run test:unit && npm run test:php",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "env:tests": "wp-env start --config .wp-env.tests.json"
  },
  "dependencies": {
    "mailcheck": "^1.1.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@wordpress/env": "^11.13.0",
    "@wordpress/scripts": "^34.1.0",
    "wp-readme-to-markdown": "^1.0.1"
  }
}
